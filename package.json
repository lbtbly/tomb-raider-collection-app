{
  "name": "vitrine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:remove-fixture": "tsx scripts/db/remove-fixture.ts",
    "check:barcode": "tsx scripts/checks/barcode-check-digit.ts",
    "check:verification": "tsx scripts/checks/verification-coverage.ts",
    "check:sources": "tsx scripts/checks/source-coverage.ts",
    "check:no-fixture": "tsx scripts/checks/no-fixture-leak.ts",
    "check:no-env-values": "tsx scripts/checks/no-env-values.ts",
    "check:ui": "node scripts/checks/ui.mjs",
    "check:all": "sh scripts/checks/all.sh",
    "test": "tsx --test tests/**/*.test.ts",
    "pw:install": "playwright install --with-deps chromium",
    "pw": "playwright test",
    "check:no-env-values:history": "tsx scripts/checks/no-env-values-history.ts",
    "coverage:map": "node scripts/checks/coverage-map.mjs",
    "check:no-local-paths": "tsx scripts/checks/no-local-paths.ts",
    "check:no-local-paths:history": "tsx scripts/checks/no-local-paths-history.ts",
    "orphan:strings": "node scripts/checks/orphan-strings.mjs",
    "gen:theme-colors": "node scripts/gen/theme-colors.mjs",
    "check:theme-colors": "node scripts/gen/theme-colors.mjs --check",
    "db:reset-catalogue": "tsx scripts/db/reset-catalogue.ts"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "idb": "8.0.3",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.1",
    "playwright": "1.62.1"
  }
}
