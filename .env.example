# Copy to .env.local for local development. Never commit a filled-in copy;
# .env* is ignored by .gitignore except this example file.

# Local Docker Postgres (docker-compose.yml). In production this is the Neon
# pooled connection string; DATABASE_URL_UNPOOLED carries the direct one for
# migrations. Local dev has no pooler, so both point at the same instance.
DATABASE_URL=postgres://vitrine:vitrine_dev_only@localhost:5433/vitrine
DATABASE_URL_UNPOOLED=postgres://vitrine:vitrine_dev_only@localhost:5433/vitrine

# Set by the operator at deploy time (see .forge/OPERATOR.md). Unused by slice 1,
# which runs entirely signed out, but declared here so the shape is not invented
# later.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=
